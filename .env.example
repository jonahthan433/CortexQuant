# Live order placement is disabled unless explicitly set to exactly true.
LIVE_MODE=false

# ======================
# BingX Demo (VST)
# ======================
BINGX_API_KEY=your_bingx_demo_api_key
BINGX_API_SECRET=your_bingx_demo_api_secret
BINGX_DEMO=true

# ======================
# Telegram
# ======================
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890
TELEGRAM_CHANNEL=@CKPscanner

# Session name (will create .session file)
TELEGRAM_SESSION=ckpscanner_session

# ======================
# Risk Management
# ======================
RISK_PER_TRADE=0.02
MAX_CONCURRENT_POSITIONS=3
MAX_DAILY_LOSS=0.05
DEFAULT_LEVERAGE=5

# ======================
# Kronos
# ======================
KRONOS_MODEL=NeoQuasar/Kronos-mini
KRONOS_DEVICE=cpu
KRONOS_MAX_CONTEXT=512

# ======================
# System
# ======================
LOG_LEVEL=INFO
DATA_DIR=/app/data
LOG_DIR=/app/logs
TIMEZONE=UTC

# Postgres (create a dedicated login role; credentials belong only here)
DATABASE_URL=postgresql://cortexquant_app:replace-me@127.0.0.1:5432/cortexquant
PAPER_DAYS=7
# PAPER_START_TS is persisted automatically in Postgres on first start.
MAX_POSITION_NOTIONAL=100
MAX_AGGREGATE_NOTIONAL=300
KRONOS_MODEL=NeoQuasar/Kronos-small
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base
KRONOS_DEVICE=auto
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080

# Bearer token for /kill-switch and /kill-switch/disable endpoints (optional).
# If not set, kill switch endpoints are disabled for safety.
# HEALTH_KILL_TOKEN=your-secure-random-token

# TLS verification for BingX exchange connections
# BINGX_VERIFY_SSL=true
# BINGX_CA_BUNDLE=/path/to/ca-bundle.pem
# BINGX_CLIENT_CERT=/path/to/client-cert.pem
